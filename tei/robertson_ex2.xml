<TEI xmlns="http://www.tei-c.org/ns/1.0">
  <teiHeader>
      <fileDesc>
         <titleStmt>
            <title>Friendship Calendar Co., March 1909</title>
         </titleStmt>
         <publicationStmt>
            <p>Digital transcription</p>
         </publicationStmt>
         <sourceDesc>
            <p>Two calendar sheets from the year 1909 on which Mary Behrend (who called herself
               Molly), drew pictures and wrote notes to her husband Ernst Behrend.</p>
         </sourceDesc>
      </fileDesc>
  </teiHeader>

   <text>
      <body>
         <div type="page" xml:id="march12">
            <head>
               <date when="1909-03-12">MARCH 12, 1909.</date>
               <date>FRIDAY</date>
            </head>
            <figure>
               <figDesc>
                  A woman wearing gray winter clothing and snowshoes
                  <!-- Are those snowshoes? -->
               </figDesc>
            </figure>
            <note type="handwritten">
               MOLLY ON 
               SNOWSHOES
               THAT MR. WEIR 
               GOT.
               PRETTY PICTURE
               IS IT NOT?!
            </note>
            <note type="handwritten">
               Love from Molly
               <!-- Not entirely sure if thats what she wrote -->
            </note>
         </div>
         
         <div type="page" xml:id="march17">
            <head>
               <date when="1909-03-17">MARCH 17, 1909.</date>
               <date>WEDNESDAY</date>
               <title>St. Patrick's Day</title>
            </head>
            <figure>
               <figDesc>
                  Two snakes surrounded by green clovers
               </figDesc>
            </figure>
            <note type="handwritten">
               ST. PATRICK WAS A USEFUL SAINT
               HE FRIGHTENED ALL THE SNAKES AWAY—
               I WISH HE'D TRY HIS ART ON SMOKE
               AROUND THE HAMMERMILL SOME DAY!
            </note>
            <figure>
               <figDesc>
                  A factory with smoke coming out
               </figDesc>
            </figure>
            <note type="handwritten">
               The Hammermill really 
               <!-- I can't read the last two words at all -->
            </note>
         </div>
      </body>
   </text>
</TEI>
