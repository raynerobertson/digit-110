<TEI xmlns="http://www.tei-c.org/ns/1.0">
  <teiHeader>
      <fileDesc>
         <titleStmt>
            <title>Friendship Calendar Co., March 1909</title>
         </titleStmt>
         <publicationStmt>
            <p>Digital transcription</p>
         </publicationStmt>
         <sourceDesc>
            <p>Two calendar sheets from the year 1909 on which Mary Behrend (who called herself
               Molly), drew pictures and wrote notes to her husband Ernst Behrend.</p>
         </sourceDesc>
      </fileDesc>
     
      <profileDesc>
        <handNotes>
           <handNote xml:id="blackPrint">
              Print writing in black ink
           </handNote>
           <handNote xml:id="redCursive">
              Cursive writing with red ink
           </handNote>
        </handNotes>
      </profileDesc>
  </teiHeader>

   <text>
      <body>
         <div type="page" xml:id="march12">
            <head>
               <date when="1909-03-12">MARCH 12, 1909.</date>
               <date type="dayOfWeek">FRIDAY</date>
            </head>
            
            <figure>
               <figDesc>
                  A woman wearing gray winter clothing and snowshoes
                  <!-- Are those snowshoes? -->
               </figDesc>
            </figure>
            
            <note type="handwritten" hand="blackPrint">
               <l>MOLLY ON</l> 
               <l>SNOWSHOES</l>
               <l>THAT MR. WEIR</l> 
               <l>GOT.</l>
               <l>PRETTY PICTURE</l>
               <l>IS IT NOT?!</l>
            </note>
            
            <note type="handwritten" hand="redCursive">
               <l>Love from Molly</l>
               <!-- Not entirely sure if thats what she wrote -->
            </note>
         </div>
         
         <div type="page" xml:id="march17">
            <head>
               <date when="1909-03-17">MARCH 17, 1909.</date>
               <date type="dayOfWeek">WEDNESDAY</date>
               <title>St. Patrick's Day</title>
            </head>
            
            <figure>
               <figDesc>
                  Two snakes surrounded by green clovers
               </figDesc>
            </figure>
            
            <note type="handwritten" hand="blackPrint">
               <l>ST. PATRICK WAS A USEFUL SAINT</l>
               <l>HE FRIGHTENED ALL THE SNAKES AWAY—</l>
               <l>I WISH HE'D TRY HIS ART ON SMOKE</l>
               <l>AROUND THE HAMMERMILL SOME DAY!</l>
            </note>
            
            <figure>
               <figDesc>
                  A factory with smoke coming out
               </figDesc>
            </figure>
            
            <note type="handwritten" hand="redCursive">
               <l>The Hammermill really...</l> 
               <!-- I can't read the last two words at all -->
            </note>
         </div>
      </body>
   </text>
</TEI>
